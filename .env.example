# ==============================================================================
# Onprs Email 环境变量配置文件 (.env)
# ==============================================================================

# 主机名与邮件服务主域名
MAIL_HOSTNAME=mail.onprs.online
MAIL_DOMAIN=onprs.online

# 宿主机绑定与数据持久化路径
STALWART_CONFIG_PATH=/opt/onprs-email/stalwart-config
STALWART_DATA_PATH=/opt/onprs-email/stalwart-data
INGRESS_DATA_PATH=/opt/onprs-email/ingress-data
SNAPPYMAIL_DATA_PATH=/opt/onprs-email/snappymail-data

# 内部反向代理监听端口 (避免与现有服务如 sub2api 8080 冲突)
STALWART_HTTP_PORT=127.0.0.1:4080
SNAPPYMAIL_HTTP_PORT=127.0.0.1:4081
INGRESS_HTTP_PORT=127.0.0.1:4082

# 通用 Ingress 鉴权 Token（首次执行 setup.sh 时自动生成）
INGRESS_SECRET_KEY=

# 桌面端创建邮箱所需的注册码（首次执行 setup.sh 时自动生成）
ACCOUNT_REGISTRATION_CODE=

# Stalwart 受限 API Key，由无密码专用 User 持有，仅额外授予 sysAccountCreate
STALWART_PROVISIONING_TOKEN=

# configure-registration.py 从固定 MAIL_DOMAIN 解析出的 Stalwart 域标识
STALWART_REGISTRATION_DOMAIN_ID=

# 公网邮件服务对外端口绑定
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995
SIEVE_PORT=4190

# 镜像引用（已按生产环境实际运行版本和 digest 固定；升级前需完成协议验证）
STALWART_IMAGE=stalwartlabs/stalwart@sha256:9ed1d343243b7aa72969e372a7240b7ddea07730781d4b68a0dc3d8d51c418bb
SNAPPYMAIL_IMAGE=djmaze/snappymail@sha256:5e3d990438809a8a49f8ac5758db03e858e6e9fc0e369e1f9e474f7664079905
