# ============================================================
# 隐私与敏感信息（严禁提交）
# ============================================================
# 本地环境变量（含 Ingress Secret、注册码、Provisioning Token 等密钥）
.env
.env.*
!.env.example

# 密钥文件（DKIM 私钥、SSL 私钥、API 凭证等）
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore

# ============================================================
# 运行时数据与备份（严禁提交）
# ============================================================
# 邮件数据与备份目录
backups/
*.tar.gz
*.zip
*.sql
*.dump

# 本地数据库文件
*.db
*.db-shm
*.db-wal

# 容器运行时挂载数据
stalwart-data/
stalwart-config/
ingress-data/
snappymail-data/

# ============================================================
# Python 缓存与虚拟环境
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ============================================================
# 系统与编辑器临时文件
# ============================================================
.DS_Store
Thumbs.db
*.log
*.tmp
.registration.lock
